# Copy to web/.env and fill in. Never commit web/.env.

# --- NEAR AI Cloud (private inference in TEEs) -------------------------------
# Get a key at https://cloud.near.ai (Credits -> API Keys).
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# Must be a NEAR-hosted, TEE-attested model (openai/* and anthropic/* are proxied
# and return no attestation). Checked live on 2026-11-08.
NEARAI_AGENT_MODEL=Qwen/Qwen3.8-27B
NEARAI_VISION_MODEL=Qwen/Qwen3.8-27B

# --- NEAR testnet ------------------------------------------------------------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Filled in automatically by `npm run testnet:setup` (writes web/.env.testnet.json).
# The escrow contract account, e.g. escrow.trusttrade-xxxx.testnet
NEXT_PUBLIC_ESCROW_CONTRACT=
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io

# --- WebAuthn ----------------------------------------------------------------
# Must match the contract's rp_id / allowed_origins (set at deploy time).
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_ORIGIN=http://localhost:3000

# --- Demo mode ---------------------------------------------------------------
# Demo personas (Alice seller, Bob buyer, Mallory prompt-injecting buyer) keep their
# testnet keys in .near-credentials/ (gitignored). Set to 0 to hide the persona switcher.
DEMO_MODE=1
